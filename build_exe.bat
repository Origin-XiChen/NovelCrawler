@echo off
rem ============================================================
rem  Build standalone app (PyInstaller **onedir**)
rem  Desktop mode: custom window (window2.py, Win32 + WebView2 COM)
rem  Output: dist\NovelCrawler\  (= NovelCrawler.exe + _internal\ + ????.txt)
rem          Zip the whole folder to distribute.
rem
rem  IMPORTANT: keep this file **pure ASCII**.
rem  cmd.exe parses .bat with the console code page (936/GBK on a Chinese
rem  Windows). A UTF-8 .bat gets mis-decoded there, and a Chinese multi-byte
rem  sequence can swallow the line ending, merging the NEXT line (an if /
rem  robocopy statement) into the previous one - which breaks the whole build.
rem  Any Chinese that must be produced (the Chinese readme) is written by
rem  build\make_readme_txt.py instead.
rem
rem  Why onedir instead of a single exe:
rem  onefile extracts ~250MB to %TEMP%\_MEIxxxxxx on **every launch**, and that
rem  happens in the PyInstaller bootloader BEFORE any Python code runs. If the
rem  TEMP/TMP visible to the process is not writable by a normal user (e.g. a
rem  machine-level TEMP of C:\WINDOWS\TEMP), the bootloader dies with
rem  "Could not create temporary directory!" and the only workaround is
rem  "run as administrator". onedir does no extraction at launch, so that
rem  failure mode disappears, startup gets faster, and no _MEI leftovers remain.
rem
rem  Packaging config lives ONLY in NovelCrawler.spec.
rem ============================================================
setlocal
cd /d "%~dp0"

set "PY=%~dp0.venv\Scripts\python.exe"
if not exist "%PY%" set "PY=%~dp0bundle314\Scripts\python.exe"
if not exist "%PY%" set "PY=%USERPROFILE%\.workbuddy\binaries\python\envs\default\Scripts\python.exe"

echo Using Python: %PY%
"%PY%" -m pip install --disable-pip-version-check -q pyinstaller
rem The verify center's automatic verification needs playwright inside the app.
"%PY%" -c "import playwright" 2>nul
if errorlevel 1 (
    echo [warn] playwright is missing in this build env; auto verification will be unavailable:
    echo        "%PY%" -m pip install playwright
)

rem Build into build\dist_out, NOT directly into dist\NovelCrawler:
rem PyInstaller wipes its output directory, and dist\NovelCrawler holds the
rem user's bookshelf/config data (novel/paths.py: APP_DATA_DIR = exe folder).
"%PY%" -m PyInstaller --noconfirm --clean ^
  --distpath "build\dist_out" ^
  --workpath "build\pyinstaller" ^
  NovelCrawler.spec

if errorlevel 1 (
    echo Build FAILED.
    pause
    exit /b 1
)

rem --- Move artifacts into dist\NovelCrawler: only build output, never user data ---
rem Drop the old _internal (pure build output), then copy the rest over.
rem robocopy without /MIR does not delete extra files, so bookshelf/config/
rem downloads survive. robocopy exit codes 0-7 all mean success.
if exist "dist\NovelCrawler\_internal" rmdir /s /q "dist\NovelCrawler\_internal"
robocopy "build\dist_out\NovelCrawler" "dist\NovelCrawler" /E /NFL /NDL /NJH /NJS /NP >nul

rem Chinese readme is generated by Python (see header) to avoid code page issues.
"%PY%" "build\make_readme_txt.py"

rem Post-build audit: resources present, no stray node.exe, sane launcher size.
"%PY%" "build\audit_exe.py"
if errorlevel 1 (
    echo Audit FAILED - the package looks incomplete.
    pause
    exit /b 1
)

echo.
echo Done. Zip the whole folder to distribute:
echo   dist\NovelCrawler\   (NovelCrawler.exe + _internal\ + readme txt)
pause
endlocal